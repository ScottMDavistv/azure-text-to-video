# Replace only after creating a Single-page application registration in Entra.
# This is the FRONTEND client ID, NOT the API client ID or workload identity.
VITE_ENTRA_SPA_CLIENT_ID=6d5e9e96-8be6-445c-9176-3b67d020612c
# The local development redirect URI is http://localhost:5173
# Never put access tokens, credentials or secrets in VITE_ variables.

# Opt-in development-only Entra project jobs. Server independently verifies access.
# Do not enable before audited project membership, OIDC, synthetic dispatch,
# downloads and safe API origin are available.
VITE_ENABLE_AUTHENTICATED_JOURNEY=false
VITE_VIDEO_PROJECT_ID=
VITE_VIDEO_API_ORIGIN=
# For a local dev reverse-proxy this origin may stay empty (same-origin).
# Never put bearer tokens, service tokens or provider credentials in VITE_ vars.
